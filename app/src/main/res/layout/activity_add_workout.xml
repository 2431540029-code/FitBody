<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Quay lại"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ Thêm bài tập mới"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <EditText
            android:id="@+id/editWorkoutName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Tên bài tập"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#7C4DFF"
            android:padding="12dp"
            android:layout_marginBottom="18dp"/>

        <EditText
            android:id="@+id/editSets"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Số hiệp (Sets)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#7C4DFF"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="18dp"/>

        <EditText
            android:id="@+id/editReps"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Số lần (Reps)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#7C4DFF"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="18dp"/>

        <EditText
            android:id="@+id/editMuscleGroup"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nhóm cơ"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#7C4DFF"
            android:padding="12dp"
            android:layout_marginBottom="35dp"/>

        <Button
            android:id="@+id/btnSaveWorkout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Lưu bài tập"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="#7C4DFF"/>

    </LinearLayout>

</ScrollView>