<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Quay lại"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="18dp"/>

        <ImageView
            android:id="@+id/imgTrainer"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtSpecialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AAAAAA"
                android:textSize="18sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/txtCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FF5252"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/txtMuscle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/txtSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:layout_marginTop="12dp"/>

            <EditText
                android:id="@+id/edtSearchWorkout"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Tìm bài tập..."
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#7C4DFF"
                android:padding="12dp"
                android:layout_marginTop="22dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAll"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="Tất cả"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#7C4DFF"/>

                    <Button
                        android:id="@+id/btnChest"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="Ngực"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#333333"
                        android:layout_marginStart="8dp"/>

                    <Button
                        android:id="@+id/btnArm"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="Tay"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#333333"
                        android:layout_marginStart="8dp"/>

                    <Button
                        android:id="@+id/btnLeg"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="Chân"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#333333"
                        android:layout_marginStart="8dp"/>

                    <Button
                        android:id="@+id/btnBackMuscle"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="Lưng"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#333333"
                        android:layout_marginStart="8dp"/>

                    <Button
                        android:id="@+id/btnShoulder"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="Vai"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#333333"
                        android:layout_marginStart="8dp"/>

                    <Button
                        android:id="@+id/btnCardio"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="Cardio"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#333333"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh sách bài tập"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="14dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>